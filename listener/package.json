    "test:core": "node --test test/parser.test.js test/buffer.test.js",
    "simulate": "node tools/simulate-device.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^5.0.0"
  }
}
