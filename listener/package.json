{
  "name": "attendance-listener",
  "version": "1.0.0",
  "description": "ADMS push listener for ZKTeco SenseFace 2A -> Supabase (Attendance OS, Stage 1)",
  "license": "MIT",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
