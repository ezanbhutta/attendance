# ─── Device identity ───────────────────────────────────────────────────────
# The device serial routes requests; it is NOT a secret (printed on the device).
# It is a routing check, not the security boundary — see the ingress section below.
DEVICE_SN=YOUR-DEVICE-SERIAL

# ─── Supabase ──────────────────────────────────────────────────────────────
# Service-role key — SERVER-SIDE ONLY. Never ship it to the browser/dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Listener bind ─────────────────────────────────────────────────────────
# Device default target is :8081 (zero reconfig). Bind to the LAN interface in
# production and NEVER expose this port to the internet (§11).
PORT=8081
BIND_ADDR=0.0.0.0

# ─── Ingress hardening (STRONGLY RECOMMENDED in production) ──────────────────
# The serial is not auth. Add at least one real control so a LAN/internet
# attacker can't forge punches or inject employees through the service-role path:
#   • LISTENER_ALLOW_IPS — comma-separated IPs allowed to reach /iclock + /admin.
#     The practical control: set it to the device's fixed LAN IP. Empty = off.
#   • LISTENER_TOKEN — shared secret required as the X-Auth-Token header (or
#     ?token=). Use it for /admin and, if your firmware can present a push key,
#     for the device too. Empty = off.
# Also firewall tcp/8081 to the device IP, and bind to the LAN interface above.
LISTENER_ALLOW_IPS=
LISTENER_TOKEN=
# Request hardening (safe defaults).
MAX_BODY_BYTES=512kb
MAX_ATTLOG_LINES=5000
RATE_LIMIT_PER_MIN=1200

# ─── Timezone ──────────────────────────────────────────────────────────────
# Device sends local wall-clock (TimeZone=5 -> Pakistan -> +05:00). The listener
# attaches this offset so punch_time is stored as an unambiguous instant.
DEVICE_TZ_OFFSET=+05:00

# ─── Durable local buffer ──────────────────────────────────────────────────
# Where punches are spooled if Supabase is unreachable, and how often the drain
# worker retries (ms). The Stage-2 gate depends on this: no lost punches on outage.
BUFFER_DIR=.buffer
DRAIN_INTERVAL_MS=15000

# ─── Employee auto-sync ────────────────────────────────────────────────────
# On every start, the catcher asks the device to upload all its users and
# imports them (so anyone enrolled while the catcher was away gets added). The
# dashboard shows the last sync time. Set to false to turn this off.
AUTO_SYNC_USERS=true
# The ADMS command used to pull users. Leave as-is unless your firmware differs.
USER_SYNC_COMMAND=DATA QUERY USERINFO
# Also re-pull the attendance the device has stored, so older punches arrive too
# (deduplicated, so re-pulling never doubles). Set false to disable.
AUTO_SYNC_HISTORY=true
ATTLOG_SYNC_COMMAND=DATA QUERY ATTLOG
