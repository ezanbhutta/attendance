# ─── Device identity ───────────────────────────────────────────────────────
# The listener ONLY accepts requests whose ?SN= matches this value (§5 SN guard).
DEVICE_SN=NYU7253801246

# ─── Supabase ──────────────────────────────────────────────────────────────
# Service-role key — SERVER-SIDE ONLY. Never ship it to the browser/dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Listener bind ─────────────────────────────────────────────────────────
# Device default target is :8081 (zero reconfig). Bind to the LAN interface in
# production and NEVER expose this port to the internet (§11).
PORT=8081
BIND_ADDR=0.0.0.0

# ─── Timezone ──────────────────────────────────────────────────────────────
# Device sends local wall-clock (TimeZone=5 -> Pakistan -> +05:00). The listener
# attaches this offset so punch_time is stored as an unambiguous instant.
DEVICE_TZ_OFFSET=+05:00

# ─── Durable local buffer ──────────────────────────────────────────────────
# Where punches are spooled if Supabase is unreachable, and how often the drain
# worker retries (ms). The Stage-2 gate depends on this: no lost punches on outage.
BUFFER_DIR=.buffer
DRAIN_INTERVAL_MS=15000

# ─── Employee auto-sync ────────────────────────────────────────────────────
# On every start, the catcher asks the device to upload all its users and
# imports them (so anyone enrolled while the catcher was away gets added). The
# dashboard shows the last sync time. Set to false to turn this off.
AUTO_SYNC_USERS=true
# The ADMS command used to pull users. Leave as-is unless your firmware differs.
USER_SYNC_COMMAND=DATA QUERY USERINFO
