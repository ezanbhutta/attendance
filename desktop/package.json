{
  "name": "attendance-desktop",
  "version": "1.0.0",
  "description": "Attendance OS desktop app — fetch punches from the device on open, store in Supabase, view reports",
  "private": true,
  "main": "src/main.js",
  "author": "Attendance OS",
  "scripts": {
    "sync": "node src/sync-cli.js",
    "test": "node --test test/sync.test.js",
    "start": "electron .",
    "bundle:renderer": "node scripts/bundle-renderer.mjs",
    "dist": "npm run bundle:renderer && electron-builder",
    "dist:linux": "npm run bundle:renderer && electron-builder --linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "node-zklib": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  }
}
